---
import '@fontsource-variable/roboto-slab';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  /** Background behind the header, to blend into the first section. */
  headerTone?: 'cream' | 'white';
  /** For the 404 page: no canonical URL, kept out of search results. */
  noindex?: boolean;
}

const { title, description, headerTone = 'white', noindex = false } = Astro.props;
const { settings } = await getContent();
const metaDescription = description || settings.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      settings.googleTagId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${settings.googleTagId}`} />
          <script is:inline define:vars={{ id: settings.googleTagId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', id);
          </script>
        </>
      )
    }
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class:list={['header-band', `header-band--${headerTone}`]}>
      <Header title={settings.title} navigation={settings.navigation} />
    </div>
    <main id="main">
      <slot />
      <Contact settings={settings} />
    </main>
    <Footer title={settings.title} socialLinks={settings.socialLinks} />
  </body>
</html>
