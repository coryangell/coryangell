---
import SocialLinks from './SocialLinks.astro';
import type { Social } from '../lib/content';

interface Props {
  title: string;
  socialLinks: Social[];
}

const { title, socialLinks } = Astro.props;
---

<footer class="site-footer">
  <div class="container footer__grid">
    <a class="brand" href="/">{title}</a>
    <a class="btn" href="#top">Back to top</a>
    <SocialLinks links={socialLinks} size="sm" />
  </div>
  <p class="copyright">Copyright © {new Date().getFullYear()} {title}.</p>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    padding: 80px 0 24px;
    color: #fff;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }
  .brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -1px;
    color: #fff;
  }
  .footer__grid :global(.social) {
    justify-self: end;
  }
  .copyright {
    margin: 32px 0 0;
    text-align: center;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 767px) {
    .footer__grid {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .footer__grid :global(.social) {
      justify-self: center;
    }
  }
</style>
